# ---------------------------------------------------------------
# 環境変数サンプル（本ファイルをコピーして .env.local を作成）
# 実際のAPIキーはフロントエンドに置かず、GAS のスクリプトプロパティ
# またはサーバー側プロキシで保持してください。
# ここに設定するのは「接続先URL」と「キー識別子（末尾数桁）」のみです。
# ---------------------------------------------------------------

# mock | gas
VITE_DATA_SOURCE=mock

# テスト環境
VITE_TEST_DEVICE_API_URL=https://sandbox.device-api.example.jp/v1
VITE_TEST_LINE_API_URL=https://sandbox.line-gateway.example.jp/v1
VITE_TEST_PLATFORM_API_URL=https://sandbox.bousai-platform.example.jp/api
VITE_TEST_GAS_URL=https://script.google.com/macros/s/TEST_DEPLOYMENT_ID/exec

# 本番環境
VITE_PROD_DEVICE_API_URL=https://device-api.example.jp/v1
VITE_PROD_LINE_API_URL=https://line-gateway.example.jp/v1
VITE_PROD_PLATFORM_API_URL=https://bousai-platform.example.jp/api
VITE_PROD_GAS_URL=https://script.google.com/macros/s/PROD_DEPLOYMENT_ID/exec

# 画面に表示するキー識別子（秘密情報そのものではない）
VITE_DEVICE_API_KEY_ID=dk_test_7f3a
VITE_LINE_CHANNEL_KEY_ID=ln_test_92bc
VITE_PLATFORM_API_KEY_ID=pf_test_15e0
